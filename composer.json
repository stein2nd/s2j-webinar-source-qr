{
	"name": "s2j/s2j-webinar-source-qr",
	"description": "WordPress companion plugin for webinar source tracking URLs and QR codes",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.1",
		"chillerlan/php-qrcode": "^5.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml.dist"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2.34"
		}
	}
}
